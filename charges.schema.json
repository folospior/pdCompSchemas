{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/folospior/pdCompSchemas/refs/heads/main/charges.schema.json",
  "title": "pdComp Charges Schema",
  "description": "The schema for the charges.json file, which is used to define charges",
  "type": "object",
  "properties": {
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "pattern": "Infraction|Misdemeanor|Felony"
          },
          "category": { "type": "string" },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "legalClass": {
            "type": "string",
            "pattern": "Violation|Infraction|Misdemeanor|Wobbler|Felony|Serious Felony"
          },
          "statute": { "type": "string" },
          "notes": { "type": "string" },
          "courtNotes": { "type": "string" },
          "seriousFelony": { "type": "boolean" },
          "violentFelony": { "type": "boolean" },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "group": { "type": "string" },
                "code": { "type": "string" },
                "description": { "type": "string" },
                "severity": {
                  "type": "string",
                  "pattern": "Violation|Infraction|Misdemeanor|Felony"
                },
                "tier": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "courtWeight": { "type": "integer" },
                "notes": { "type": "string" }
              }
            }
          },
          "enhancements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "label": { "type": "string" },
                "statute": { "type": "string" },
                "tierDelta": { "type": "integer" },
                "courtWeight": { "type": "integer" },
                "sentenceMonths": { "type": "integer" },
                "notes": { "type": "string" }
              }
            }
          }
        },
        "required": ["code", "description", "severity"]
      }
    }
  }
}
